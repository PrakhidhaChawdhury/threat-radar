# ─────────────────────────────────────────────
#  Threat Radar — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Bright Data API Token
# Get from: Bright Data Dashboard → Account Settings → API Tokens
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Bright Data Collector IDs
# Create via: bdata scraper create <URL> "<description>"
# Then copy the c_* ID from the output
REDDIT_SCAMS_COLLECTOR_ID=c_your_reddit_collector_id
GITHUB_ADVISORIES_COLLECTOR_ID=c_your_github_collector_id

# Discord Webhook URL
# Create via: Discord Server → Channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Pipeline Configuration (optional overrides)
POLLING_INTERVAL_MINUTES=30
RELEVANCE_THRESHOLD=8
